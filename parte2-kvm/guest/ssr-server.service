[Unit]
Description=SSR-master-server (Node.js Data-Logger)
After=agr-net.service network.target
Wants=agr-net.service

[Service]
Type=simple
User=nodeapp
WorkingDirectory=/opt/ssr-master-server
Environment=NODE_ENV=production
Environment=PORT=3000
# app.js ya hace app.listen(3000); "npm start" (bin/www) falla con EADDRINUSE
ExecStart=/opt/node/bin/node app.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
